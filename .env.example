# Live-head RPC for the Phase 0 diagnostic probes in apps/indexer/scripts.
# Non-archive: only ~100 blocks of lookback (measured against Chainstack's
# Developer plan, since decommissioned). Any working BSC mainnet RPC works.
# NOT used by the app — production reads run on ALCHEMY_BSC.
BSC_RPC=
BSC_WSS=

# Historical log source. Required for P6-P9 (eth_getLogs over historical ranges).
# BNB Smart Chain mainnet endpoint URL, e.g. https://bnb-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_BSC=

# DEAD PATH - not read by any probe. Kept only so an existing .env still loads.
#   api.bscscan.com V1        -> NOTOK, deprecated (migration message)
#   api.etherscan.io/v2 cid=56 -> NOTOK, "Free API access is not supported for this chain."
BSCSCAN_KEY=

# Altana session-key spike. MUST be 97 (BNB Smart Chain Testnet).
# The MCP server and SDK BOTH default to MAINNET (chain 56) when this is unset:
#   @altananetwork/mcp src/index.ts -> NETWORKS[requestedChain] ?? BNB
# Register the MCP server with it explicitly:
#   claude mcp add altana -e ALTANA_CHAIN=97 -- bunx @altananetwork/mcp
ALTANA_CHAIN=97

# Admin signer for the Altana smart account. Testnet key only. Never commit.
AGENT_KEY=

# Supabase. SUPABASE_SERVICE_KEY bypasses RLS — server-side only, NEVER in a
# browser bundle. Dashboard > Project Settings > API Keys > Secret key (sb_secret_…).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Publishable ("anon") key. This is PUBLIC by design — it ships in the frontend
# bundle. Safe only because 003_rls.sql enables RLS and grants anon SELECT-only
# on bazaar_resources, bazaar_accepts, agent_liveness, agents (+ the two views),
# and NO access at all to sweep_cursor. Verified empirically, not by reading the
# policy: anon INSERT/UPDATE/DELETE all return 401 42501, and sweep_cursor
# returns 401 on SELECT.
# Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_…).
SUPABASE_ANON_KEY=

# Bearer token for POST /api/revalidate (on-demand ISR after a sweep).
REVALIDATE_SECRET=

# Bearer secret for POST /api/revalidate AND the HMAC key behind
# /api/gas-dispense's nonce mint — the dispenser 500s locally without it.
REVALIDATE_SECRET=

# 8004scan Pro API key. Pro access EXPIRES 9 Sep 2026 — judging runs to 23 Sep,
# so nothing at runtime may depend on this. It is an INGEST-ONLY credential:
# enrichment is pulled into our own tables and served from there.
# Header: X-API-Key. Docs: https://8004scan.io/developers
EIGHT004SCAN_KEY=

# ---------------------------------------------------------------------------
# The Graph gateway. Scout and every lib/graph read go through this one key.
# The gateway puts it in the URL PATH, which makes the URL itself a secret —
# lib/graph/client.ts never logs a URL and redacts the path out of nested
# fetch errors. Get one at https://thegraph.com/studio/apikeys/
THEGRAPH_API_KEY=

# Scout's LLM. One of: groq | google | anthropic | openai.
# Unset defaults to GROQ, which is the recommended provider — see below.
# Only the key for the ACTIVE provider needs a value; lib/llm.ts throws at call
# time (not import time) naming the variable it wanted.
LLM_PROVIDER=groq

# groq      -> openai/gpt-oss-120b  https://console.groq.com/keys      RECOMMENDED
# google    -> gemini-3.8-flash     https://aistudio.google.com/apikey
# anthropic -> claude-sonnet-5      https://console.anthropic.com/settings/keys
# openai    -> gpt-5-mini           https://platform.openai.com/api-keys
#
# WHY GROQ IS THE DEFAULT: free-tier daily budget, the binding constraint on a
# demo. Gemini allows 20 requests per DAY per model and Scout spends one per
# reasoning step, so ~4 questions exhaust it. Groq allows 1,000 requests/day
# AND 200,000 tokens/day; tokens run out first — a question costs ~5-10K
# across its tool loop, so budget ~20-40 questions/day. Still roughly 5-10x
# Gemini's headroom, and both pools are per model (see LLM_MODEL).
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override, all providers. Free-tier quota is metered PER MODEL,
# so when one runs out the fix is to name another — no code change, no redeploy.
#   groq:   openai/gpt-oss-120b (default) | openai/gpt-oss-20b
#           1,000 requests/day and 200,000 tokens/day EACH, pooled per model,
#           so switching here buys a fresh token budget when one runs dry.
#           20b is a FALLBACK, not an equal: it intermittently leaks its
#           harmony channel marker into the function name and Groq rejects
#           the call. Avoid qwen/qwen3.6-27b entirely: it 429s ("request too
#           large") even on a trivial call.
#   google: gemini-3.8-flash (default) | gemini-3.7-flash | gemini-3.6-flash
#           | gemini-3.5-flash | gemini-3.5-flash-lite — 20 requests/day EACH.
# LLM_MODEL=openai/gpt-oss-20b
